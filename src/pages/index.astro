---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Mission from '../components/sections/Mission.astro';
import Marquee from '../components/sections/Marquee.astro';
import Metodo from '../components/sections/Metodo.astro';
import Ambiti from '../components/sections/Ambiti.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Contatti from '../components/sections/Contatti.astro';
---

<BaseLayout
  title="Studio Grafitech | Progettazione architettonica ad Aosta"
  description="Studio associato di progettazione architettonica ad Aosta: progettazione, direzione lavori, rilievi, pratiche catastali, sicurezza, antincendio e acustica."
  path="/"
>
  <Hero />
  <Mission />
  <Marquee />
  <Metodo />
  <Ambiti />
  <Portfolio />
  <Contatti />
</BaseLayout>
